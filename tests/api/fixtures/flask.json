{
  "openapi": "3.0.2",
  "info": {
    "title": "Flask Inventory",
    "version": "0.9.0",
    "description": "Inventory service documented with flasgger."
  },
  "servers": [
    {
      "url": "http://localhost:4010"
    }
  ],
  "tags": [
    {
      "name": "inventory",
      "description": "Stock keeping."
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "tags": [
          "inventory"
        ],
        "summary": "List inventory items",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search term.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "inventory"
        ],
        "summary": "Add an item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sku",
                  "quantity"
                ],
                "properties": {
                  "sku": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}-\\d{3}$"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "location": {
                    "type": "string",
                    "default": "main"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload"
          }
        }
      }
    },
    "/items/{sku}": {
      "get": {
        "tags": [
          "inventory"
        ],
        "summary": "Read one item",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "ABC-123"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "example": 12
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ]
}
