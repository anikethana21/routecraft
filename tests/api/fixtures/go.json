{
  "swagger": "2.0",
  "info": {
    "title": "Go Orders API",
    "version": "1.0.0",
    "description": "Orders service documented with go-swagger (Swagger 2.0)."
  },
  "host": "127.0.0.1:4010",
  "basePath": "/api/v1",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "tags": [
    {
      "name": "orders"
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "List orders",
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "format": "int64",
            "default": 20,
            "minimum": 1,
            "maximum": 200
          },
          {
            "name": "state",
            "in": "query",
            "type": "string",
            "enum": [
              "open",
              "paid",
              "shipped"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Order"
              }
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Create an order",
        "operationId": "createOrder",
        "security": [
          {
            "api_key": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The order to create.",
            "schema": {
              "$ref": "#/definitions/NewOrder"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/Order"
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get an order",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "schema": {
              "$ref": "#/definitions/Order"
            }
          },
          "404": {
            "description": "Not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/orders/{orderId}/attachments": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Attach a receipt",
        "operationId": "attachReceipt",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "type": "string",
            "required": true
          },
          {
            "name": "file",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "Receipt file."
          },
          {
            "name": "note",
            "in": "formData",
            "type": "string",
            "description": "Optional note."
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "X-API-Key",
      "in": "header",
      "description": "Service API key."
    }
  },
  "definitions": {
    "Order": {
      "type": "object",
      "required": [
        "id",
        "total"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "ord_123"
        },
        "total": {
          "type": "number",
          "format": "double",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "paid",
            "shipped"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrderItem"
          }
        }
      }
    },
    "OrderItem": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "NewOrder": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/OrderItem"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        }
      }
    }
  }
}
