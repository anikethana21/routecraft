{
  "openapi": "3.1.0",
  "info": {
    "title": "Edge Cases",
    "version": "0.0.1",
    "description": "Recursive schemas, anyOf, const, and unusual parameter styles."
  },
  "paths": {
    "/tree": {
      "post": {
        "tags": [
          "edge"
        ],
        "summary": "Build a tree",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Node"
              },
              "examples": {
                "sample": {
                  "value": {
                    "name": "root",
                    "children": [
                      {
                        "name": "leaf"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The same tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Node"
                }
              }
            }
          }
        }
      }
    },
    "/anything": {
      "get": {
        "tags": [
          "edge"
        ],
        "summary": "Anything",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "X-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "const": "fast"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A union",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Node"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Node": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      },
      "oauth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "read:all": "Read everything",
              "write:all": "Write everything"
            }
          }
        }
      }
    }
  }
}
