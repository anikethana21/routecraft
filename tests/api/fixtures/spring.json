{
  "openapi": "3.0.1",
  "info": {
    "title": "Spring Pet Clinic",
    "version": "4.0.0",
    "description": "Springdoc-generated API with server variables and basic auth."
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}/api",
      "description": "Generated server",
      "variables": {
        "protocol": {
          "default": "http",
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "default": "localhost"
        },
        "port": {
          "default": "4010"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "owners"
    }
  ],
  "paths": {
    "/owners": {
      "get": {
        "tags": [
          "owners"
        ],
        "summary": "List owners",
        "parameters": [
          {
            "name": "lastName",
            "in": "query",
            "description": "Filter by last name prefix.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Owner"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "owners"
        ],
        "summary": "Create an owner",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Owner"
                }
              }
            }
          }
        }
      }
    },
    "/owners/{ownerId}": {
      "get": {
        "tags": [
          "owners"
        ],
        "summary": "Find an owner",
        "parameters": [
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Owner"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OwnerInput": {
        "type": "object",
        "required": [
          "firstName",
          "lastName"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "telephone": {
            "type": "string",
            "pattern": "\\d{10}"
          }
        }
      },
      "Owner": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OwnerInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "readOnly": true
              },
              "pets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
